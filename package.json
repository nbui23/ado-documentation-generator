{
  "name": "edgar",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "EDGAR — Evidence-Driven Generation for Azure Repositories.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nbui23/ado-documentation-generator.git"
  },
  "homepage": "https://github.com/nbui23/ado-documentation-generator#readme",
  "bugs": {
    "url": "https://github.com/nbui23/ado-documentation-generator/issues"
  },
  "bin": {
    "edgar": "./dist/cli/main.js"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:contract": "vitest run tests/contract --passWithNoTests",
    "test:database": "vitest run tests/integration/database.test.ts",
    "test:e2e": "npm run build && node scripts/sandbox-e2e.mjs",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:security": "vitest run tests/security --passWithNoTests",
    "test:unit": "vitest run tests/unit --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@azure/identity": "^4.11.1",
    "commander": "^14.0.0",
    "kysely": "^0.29.4",
    "minimatch": "^10.1.1",
    "openai": "^6.49.0",
    "pg": "^8.16.3",
    "pino": "^9.7.0",
    "yaml": "^2.8.1",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.1.0",
    "@types/pg": "^8.15.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "testcontainers": "^12.0.4",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.57.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "archiver": "^8.0.0"
  }
}
